{
  "name": "smartchart-app",
  "version": "1.0.0",
  "description": "SmartChart 移动端 App",
  "scripts": {
    "dev:h5": "uni",
    "build:h5": "uni build",
    "dev:app": "uni -p app",
    "build:app": "uni build -p app && mkdir -p dist/build/app/unpackage && cp -r src/unpackage/res dist/build/app/unpackage/res",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:mp-weixin": "uni build -p mp-weixin",
    "release:mp-weixin": "uni build -p mp-weixin --minify",
    "build:mp:server": "VITE_DEFAULT_SERVER=https://smartchart.cn/m/ uni build -p mp-weixin",
    "deploy:h5": "npm run build:h5 && bash scripts/deploy-h5.sh"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5010520260709002",
    "@dcloudio/uni-app-plus": "3.0.0-5010520260709002",
    "@dcloudio/uni-components": "3.0.0-5010520260709002",
    "@dcloudio/uni-h5": "3.0.0-5010520260709002",
    "@dcloudio/uni-mp-weixin": "3.0.0-5010520260709002",
    "vue": "3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-automator": "3.0.0-5010520260709002",
    "@dcloudio/uni-cli-shared": "3.0.0-5010520260709002",
    "@dcloudio/uni-stacktracey": "3.0.0-5010520260709002",
    "@dcloudio/vite-plugin-uni": "3.0.0-5010520260709002",
    "@vue/runtime-core": "3.5.39",
    "rollup": "4.14.3",
    "vite": "5.2.8"
  }
}
